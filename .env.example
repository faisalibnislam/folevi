# Folevi environment variables — names and descriptions only. Never commit real values.
# Web (Vercel project env, per environment) ------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=            # Convex deployment URL (set automatically by `npx convex deploy --cmd` on Vercel)
NEXT_PUBLIC_CONVEX_SITE_URL=       # Convex HTTP actions origin (*.convex.site); derived from the URL when unset
NEXT_PUBLIC_APP_URL=               # https://app.folevi.com (preview: the preview URL)
NEXT_PUBLIC_MARKETING_URL=         # https://folevi.com
FOLEVI_SERVER_SECRET=              # shared with Convex; proves share-page calls come from the web server
CONVEX_DEPLOY_KEY=                 # Production key in Production env, Preview key in Preview env (Vercel only)

# Local development only (written by scripts/setup-local.mjs into apps/web/.env.local) -------------
FOLEVI_DEV_MAILBOX_SECRET=         # same value as on Convex; lets /dev/mailbox read captured identity emails (never on Vercel production)
NEXT_PUBLIC_ENABLE_SW=             # "1" registers the service worker in development

# Convex deployment env (`npx convex env set NAME value`) -------------------------------------------
FOLEVI_ENV=                        # production | preview | development | test (non-production blocks real recipients)
FOLEVI_APP_URL=                    # https://app.folevi.com — used in email links
FOLEVI_HASH_SALT=                  # random secret for keyed hashes of emails, IPs, user agents, session ids
FOLEVI_FILE_URL_SECRET=            # random secret for signed file URLs
FOLEVI_SERVER_SECRET=              # same value as the web app
FOLEVI_REQUIRE_VERIFIED_EMAIL=     # default true; only set "false" in automated tests
FOLEVI_EMAIL_ALLOWLIST=            # non-production: comma-separated exact addresses allowed besides @example.com/@test.com
SITE_URL=                          # the app origin Better Auth runs under (https://app.folevi.com); links in identity emails use it
BETTER_AUTH_SECRET=                # 32+ random bytes (base64): `openssl rand -base64 32` — signs sessions and tokens
FOLEVI_DEV_MAILBOX_SECRET=         # non-production only: enables the local development mailbox; never set in production
FOLEVI_AUTH_RATE_LIMIT_SCALE=      # non-production only: multiplies sign-in/sign-up rate limits for automated tests (default 200)
# Transactional email (Mailtrap). Convex env only; see docs/EMAIL_OPERATIONS.md.
MAILTRAP_API_TOKEN=                # Mailtrap sending API token (Email API, mail.folevi.com); required in production
MAILTRAP_WEBHOOK_SECRET=           # signing secret of the Mailtrap webhook → POST <convex-site>/webhooks/mailtrap
EMAIL_REPLY_TO=                    # optional: monitored Reply-To address (e.g. support@folevi.com)
MAILTRAP_SANDBOX_INBOX_ID=         # non-production only: Mailtrap Email Sandbox inbox id (numeric) — mail is captured, never delivered
MAILTRAP_SANDBOX_TOKEN=            # non-production only: API token with access to that sandbox inbox
EMAIL_SENDING_DOMAIN=              # optional: From domain (default mail.folevi.com; e.g. mail-staging.folevi.com)
EMAIL_BRAND_BASE_URL=              # optional: https base for the email logo (default https://folevi.com/brand/email)
UNSPLASH_ACCESS_KEY=               # optional: Unsplash API access key (server only) — enables Insert → Image from Unsplash

# AI assistant (Google Gemini). Set on the Convex deployment (npx convex env set …), never NEXT_PUBLIC_*.
GEMINI_API_KEY=                    # server-only Gemini API key; unset = AI features show "not set up"
GEMINI_MODEL=                      # optional; default gemini-3.8-flash
GEMINI_FAST_MODEL=                 # optional; default gemini-flash-lite-latest (search terms, fallback)

# Billing (Stripe). All server-only (Convex env). Without them, upgrades say payments aren't set up,
# and non-production deployments offer test purchases instead (never in production).
STRIPE_SECRET_KEY=                  # sk_live_… / sk_test_…
STRIPE_WEBHOOK_SECRET=              # whsec_… for POST <convex-site>/webhooks/stripe
STRIPE_PRICE_BASIC_MONTH=           # Stripe price id, $2/month
STRIPE_PRICE_BASIC_YEAR=            # Stripe price id, $9/year
STRIPE_PRICE_PRO_MONTH=             # Stripe price id, $5/month
STRIPE_PRICE_PRO_YEAR=              # Stripe price id, $49/year
# Workspace plans, per member seat (recurring, "per unit" prices; the app sets the quantity to the seats).
# Workspace checkout turns on only when all four are set.
STRIPE_PRICE_WS_TEAM_MONTH=         # Stripe price id, $5 per member / month
STRIPE_PRICE_WS_TEAM_YEAR=          # Stripe price id, $49 per member / year
STRIPE_PRICE_WS_BUSINESS_MONTH=     # Stripe price id, $10 per member / month
STRIPE_PRICE_WS_BUSINESS_YEAR=      # Stripe price id, $99 per member / year
STRIPE_PORTAL_CONFIG_WS=            # optional bpc_… customer-portal configuration for workspaces (no quantity edits)
