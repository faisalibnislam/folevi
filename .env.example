# Folevi environment variables — names and descriptions only. Never commit real values.
# Web (Vercel project env, per environment) ------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=            # Convex deployment URL (set automatically by `npx convex deploy --cmd` on Vercel)
NEXT_PUBLIC_CONVEX_SITE_URL=       # Convex HTTP actions origin (*.convex.site); derived from the URL when unset
NEXT_PUBLIC_APP_URL=               # https://app.folevi.com (preview: the preview URL)
NEXT_PUBLIC_MARKETING_URL=         # https://folevi.com
AUTH0_DOMAIN=                      # auth.folevi.com (Auth0 custom domain) — Regular Web Application
AUTH0_CLIENT_ID=                   # Regular Web Application client id
AUTH0_CLIENT_SECRET=               # Regular Web Application client secret (server only)
AUTH0_SECRET=                      # 32-byte hex for session cookie encryption: `openssl rand -hex 32`
APP_BASE_URL=                      # https://app.folevi.com (omit on previews to use the request host)
FOLEVI_SERVER_SECRET=              # shared with Convex; proves share-page/verify-email calls come from the web server
CONVEX_DEPLOY_KEY=                 # Production key in Production env, Preview key in Preview env (Vercel only)

# Local development only (written by scripts/setup-local.mjs into apps/web/.env.local) -------------
FOLEVI_DEV_AUTH=                   # "1" enables the local development identity (never set on Vercel)
FOLEVI_DEV_AUTH_ISSUER=            # http://localhost:3000/dev-auth
FOLEVI_DEV_AUTH_KID=               # key id for the dev signing key
FOLEVI_DEV_AUTH_PRIVATE_KEY=       # base64 PKCS#8 RSA key (local only)
FOLEVI_SESSION_SECRET=             # HMAC key for the dev session cookie (local only)
FOLEVI_ALLOW_DEV_AUTH_BUILD=       # "1" lets a local `next start` build use dev sign-in (never on Vercel)
NEXT_PUBLIC_ENABLE_SW=             # "1" registers the service worker in development

# Convex deployment env (`npx convex env set NAME value`) -------------------------------------------
FOLEVI_ENV=                        # production | preview | development | test (non-production blocks real recipients)
FOLEVI_APP_URL=                    # https://app.folevi.com — used in email links
FOLEVI_HASH_SALT=                  # random secret for keyed hashes of emails, IPs, user agents, session ids
FOLEVI_FILE_URL_SECRET=            # random secret for signed file URLs
FOLEVI_SERVER_SECRET=              # same value as the web app
FOLEVI_REQUIRE_VERIFIED_EMAIL=     # default true; only set "false" in automated tests
FOLEVI_REQUIRE_MFA=                # default true; only set "false" in automated tests
FOLEVI_EMAIL_ALLOWLIST=            # non-production: comma-separated exact addresses allowed besides @example.com/@test.com
FOLEVI_DEV_AUTH_JWKS=              # "none" in production and preview; local dev key set by setup-local
FOLEVI_DEV_AUTH_ISSUER=            # "none" in production
AUTH0_DOMAIN=                      # tenant/custom domain trusted for ID tokens ("none" to disable)
AUTH0_WEB_CLIENT_ID=               # Regular Web Application client id (token audience)
AUTH0_MAC_CLIENT_ID=               # Native Application client id (token audience)
AUTH0_MGMT_DOMAIN=                 # tenant domain (*.auth0.com) for the Management API
AUTH0_MGMT_CLIENT_ID=              # machine-to-machine app with minimal scopes (see infra/auth0/README.md)
AUTH0_MGMT_CLIENT_SECRET=
AUTH0_DB_CONNECTION=               # Username-Password-Authentication
LOOPS_API_KEY=                     # Loops API key (server only)
LOOPS_WEBHOOK_SECRET=              # whsec_… — enables signed delivery/bounce/complaint webhooks
LOOPS_TRANSACTIONAL_AUTH_VERIFY_EMAIL_ID=
LOOPS_TRANSACTIONAL_AUTH_PASSWORD_RESET_ID=
LOOPS_TRANSACTIONAL_AUTH_BLOCKED_ACCOUNT_ID=
LOOPS_TRANSACTIONAL_AUTH_BREACHED_PASSWORD_ID=
LOOPS_TRANSACTIONAL_AUTH_VERIFICATION_CODE_ID=
LOOPS_TRANSACTIONAL_SECURITY_NEW_DEVICE_ID=
LOOPS_TRANSACTIONAL_ACCOUNT_DELETION_SCHEDULED_ID=
LOOPS_TRANSACTIONAL_ACCOUNT_DELETION_COMPLETED_ID=
LOOPS_TRANSACTIONAL_WORKSPACE_INVITE_ID=
LOOPS_TRANSACTIONAL_MENTION_NOTIFICATION_ID=
LOOPS_TRANSACTIONAL_COMMENT_NOTIFICATION_ID=
LOOPS_TRANSACTIONAL_COMMENT_DIGEST_ID=
LOOPS_TRANSACTIONAL_SHARE_NOTIFICATION_ID=
