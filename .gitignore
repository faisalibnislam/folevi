# deps
node_modules/
.pnpm-store/

# builds
.next/
.next-*/
out/
# The bundled app shell (FOLEVI_BUILD=shell next build, docs/LOCAL_MODE_PLAN.md §1).
out-shell/
# Its copy inside the Mac app (pnpm --filter @folevi/web build:shell).
apps/desktop/web/
# ...and inside the Android app (build-shell.mjs --platform android).
apps/android/web/
# ...and inside the iPhone and iPad app (build-shell.mjs --platform ios).
apps/ios/web/
# The iPhone and iPad app's TestFlight builds (apps/ios/scripts/release.mjs).
apps/ios/release/
dist/
build/
# Folevi for Mac keeps its signing entitlements and icon in build/ (electron-builder's resources folder).
!apps/desktop/build/
.turbo/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/

# env
.env
.env.*
!.env.example
.convex/

# macOS
.DS_Store
*.xcuserstate
xcuserdata/
*.xcscmblueprint

# misc
*.log
.vercel
.idea/
.vscode/*
!.vscode/extensions.json
artifacts/

# local visual QA account (scripts only)
apps/web/e2e/.visual-account.json

# Local Claude Code preview config
.claude/
backups/
# The Android e2e scripts' test account on the dev server (apps/android/scripts/e2e).
apps/android/.e2e-account.json
