<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Folevi's own look (neutral chrome, the page draws everything); Android draws only the system bars. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <!-- Capacitor switches to this once the web view is up. -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="android:background">@null</item>
    </style>

    <!-- The launch screen: the canvas colour with Folevi's mark. -->
    <style name="AppTheme.Launch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
