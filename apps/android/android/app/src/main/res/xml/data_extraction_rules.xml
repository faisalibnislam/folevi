<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing goes to cloud backups or device transfers: secrets are sealed with this phone's Keystore (useless
     elsewhere), and a local library syncs through Dropbox or Google Drive, not Android's backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
