<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Before Compose draws: the canvas color, so the first frame matches the app. -->
    <style name="Theme.Folevi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/canvas</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Folevi</item>
    </style>

    <!-- Light by day (values-night has the dark one): the Page View's prefers-color-scheme follows the activity
         theme's isLightTheme, so a dark parent here made every note page dark on a light phone. -->
    <style name="Theme.Folevi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
    </style>

    <!-- "Save to Folevi" and "Quick add to": a card over the app it came from, the rest dimmed. -->
    <style name="AppTheme.Share" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.3</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>
</resources>
