{
  "manifest_version": 3,
  "name": "Folevi Web Clipper",
  "short_name": "Folevi Clipper",
  "description": "Save the article you're reading, or the part you selected, as a clean note in your Folevi Inbox.",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "homepage_url": "https://folevi.com/docs/web-clipper",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Folevi Web Clipper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "identity", "contextMenus"],
  "host_permissions": ["https://app.folevi.com/*"]
}
