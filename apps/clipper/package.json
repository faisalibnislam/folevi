{
  "name": "@folevi/clipper",
  "version": "1.0.0",
  "private": true,
  "description": "Folevi Web Clipper for Chrome and Edge: saves the article you're reading, or the part you selected, as a clean note in your Folevi Inbox.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "FOLEVI_ORIGIN=http://app.localhost:3002 node scripts/build.mjs",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.13.6",
    "esbuild": "0.27.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
