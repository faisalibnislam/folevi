<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- FoleviFiles.app (folevi-files as a signed helper app, scripts/build-helper.mjs): Folevi's iCloud container,
     iCloud.com.folevi, the folder the iPhone and iPad app keeps its library in. These are restricted
     entitlements: macOS allows them only with build/FoleviFiles.provisionprofile (Developer ID, App ID
     com.folevi.mac.files, team 7K32QQ2FX8) embedded in the bundle. -->
<dict>
	<key>com.apple.application-identifier</key>
	<string>7K32QQ2FX8.com.folevi.mac.files</string>
	<key>com.apple.developer.team-identifier</key>
	<string>7K32QQ2FX8</string>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.folevi</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.folevi</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
</dict>
</plist>
