{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folevi",
  "mainBinaryName": "Folevi",
  "version": "../package.json",
  "identifier": "com.folevi.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage"],
    "publisher": "Folevi",
    "copyright": "Copyright © 2026 Folevi",
    "category": "Productivity",
    "shortDescription": "A calm place for notes, tasks and ideas",
    "longDescription": "Folevi is a calm writing and notes workspace: nested pages, tasks, a calendar, canvases, sharing, offline editing and sync, optional end-to-end encryption and Foli AI. Keep your notes in your Folevi account or as files on this computer.",
    "homepage": "https://folevi.com",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "icons/tray.png": "tray.png" },
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "section": "editors" },
      "appimage": { "bundleMediaFramework": false }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["folevi"] }
    },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://folevi.com/download/desktop/{{target}}-{{arch}}/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
