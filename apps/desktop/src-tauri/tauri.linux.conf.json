{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.folevi.Folevi",
  "mainBinaryName": "folevi",
  "bundle": {
    "icon": [
      "../../../packaging/linux/icons/16x16.png",
      "../../../packaging/linux/icons/22x22.png",
      "../../../packaging/linux/icons/24x24.png",
      "../../../packaging/linux/icons/32x32.png",
      "../../../packaging/linux/icons/48x48.png",
      "../../../packaging/linux/icons/64x64.png",
      "../../../packaging/linux/icons/128x128.png",
      "../../../packaging/linux/icons/256x256.png",
      "../../../packaging/linux/icons/512x512.png"
    ],
    "targets": [
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Productivity",
    "shortDescription": "Notes, tasks and docs in one calm place (Beta)",
    "longDescription": "Folevi keeps your notes, tasks and documents together. A Folevi account syncs them with the web, Mac, Windows, iPhone, iPad and Android apps. Folevi for Linux is in beta: it works, but expect rough edges. Send feedback at https://folevi.com/support.",
    "homepage": "https://folevi.com",
    "publisher": "Space Cherries LLC",
    "copyright": "Copyright 2026 Space Cherries LLC",
    "license": "LicenseRef-proprietary",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/com.folevi.Folevi.metainfo.xml": "../../../packaging/linux/com.folevi.Folevi.metainfo.xml"
        }
      },
      "deb": {
        "section": "editors",
        "priority": "optional",
        "desktopTemplate": "../../../packaging/linux/folevi.desktop.hbs",
        "depends": [
          "xdg-utils"
        ],
        "recommends": [
          "gnome-keyring | kwalletmanager | keepassxc",
          "xdg-desktop-portal"
        ],
        "files": {
          "/usr/share/metainfo/com.folevi.Folevi.metainfo.xml": "../../../packaging/linux/com.folevi.Folevi.metainfo.xml",
          "/usr/lib/folevi/folevi-archive-keyring.gpg": "../../../packaging/linux/repo/keys/folevi-archive-keyring.gpg"
        },
        "postInstallScript": "../../../packaging/linux/repo/deb-postinst.sh"
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "../../../packaging/linux/folevi.desktop.hbs",
        "depends": [
          "xdg-utils"
        ],
        "files": {
          "/usr/share/metainfo/com.folevi.Folevi.metainfo.xml": "../../../packaging/linux/com.folevi.Folevi.metainfo.xml",
          "/usr/lib/folevi/RPM-GPG-KEY-folevi": "../../../packaging/linux/repo/keys/RPM-GPG-KEY-folevi"
        },
        "postInstallScript": "../../../packaging/linux/repo/rpm-postinst.sh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "folevi"
        ]
      }
    }
  }
}
