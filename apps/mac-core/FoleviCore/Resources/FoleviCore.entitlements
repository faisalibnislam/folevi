<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Folevi Core (Developer ID, hardened runtime, not sandboxed, direct download only). No JIT entitlements:
	     WebKit's JIT runs in its own signed processes. Recording into notes. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
