{
  "name": "@folevi/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:shell": "FOLEVI_BUILD=shell next dev --hostname 0.0.0.0 --port 3003",
