{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@convex/*": ["../../convex/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "proxy.ts", "*.config.ts", "e2e/**/*.ts", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": ["node_modules"]
}
