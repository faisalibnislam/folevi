{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && node scripts/check-prod-env.mjs && npx convex deploy --cmd 'pnpm --filter @folevi/web build' --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] || git diff --quiet HEAD^ HEAD -- . ../../packages ../../convex ../../scripts ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml ../../turbo.json ../../tsconfig.base.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.folevi.com"
        }
      ],
      "destination": "https://folevi.com/:path*",
      "permanent": true
    }
  ]
}
