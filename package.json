{
  "name": "folevi",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "convex dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint convex",
    "typecheck": "turbo run typecheck && tsc -p convex/tsconfig.json --noEmit",
    "test": "turbo run test && vitest run --project convex",
    "test:convex": "vitest run --project convex",
    "test:contract": "vitest run --project contract",
    "contract:update": "UPDATE_API_SNAPSHOT=1 vitest run --project contract",
    "tokens": "pnpm --filter @folevi/design-tokens build",
    "schema:gen": "pnpm --filter @folevi/editor-schema generate",
    "engine:gen": "node scripts/engine-codegen.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.6.33",
    "@better-auth/passkey": "1.6.33",
    "@convex-dev/better-auth": "0.12.5",
    "@folevi/ai-prompts": "workspace:*",
    "@folevi/editor-schema": "workspace:*",
    "@folevi/email": "workspace:*",
    "@folevi/local-store": "workspace:*",
    "better-auth": "1.6.33",
    "convex": "1.46.0",
    "fflate": "0.8.3",
    "ts-fsrs": "5.4.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/web-push": "3.6.4",
    "convex-test": "0.0.60",
    "esbuild": "0.27.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
