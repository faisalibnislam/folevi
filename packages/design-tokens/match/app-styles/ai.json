{
  "$description": "Foli AI (apps/web/src/components/views/AiView.tsx, components/ai/AskAiPanel.tsx, components/ai/chat/*): the AI page with a new chat, the fixture's conversation (screens.mjs AI_FIXTURE, the Debug app's stand-in model), and the floating Ask Foli AI chat over Home.",
  "screens": {
    "page": "folevi-dev://ai",
    "chat": "folevi-dev://ai",
    "panel": "folevi-dev://documents"
  },
  "prepare": {
    "chat": "if (!document.getElementById('__aiStill')) { const st = document.createElement('style'); st.id = '__aiStill'; st.textContent = '*,*::before,*::after{animation:none!important;transition:none!important}'; document.documentElement.appendChild(st); } document.querySelector(\"main nav[aria-label='Conversations'] li a\")?.click(); await new Promise((r) => setTimeout(r, 1500)); return true;",
    "panel": "if (!document.getElementById('__aiStill')) { const st = document.createElement('style'); st.id = '__aiStill'; st.textContent = '*,*::before,*::after{animation:none!important;transition:none!important}'; document.documentElement.appendChild(st); } if (!document.querySelector(\".ai-chat section[role='dialog']:not([hidden])\")) window.dispatchEvent(new KeyboardEvent('keydown', { key: 'j', code: 'KeyJ', metaKey: true, bubbles: true })); await new Promise((r) => setTimeout(r, 1500)); return true;"
  },
