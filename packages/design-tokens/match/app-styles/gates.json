    "acct.item.last": {
      "screen": "account-menu",
      "selector": "[role='menu'] > button[role='menuitem']",
      "nth": 2
    },
    "acct.trigger": {
      "screen": "account-menu",
      "selector": "button[aria-haspopup][aria-label$='settings and help']"
