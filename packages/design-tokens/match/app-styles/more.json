{
  "$description": "Search, notifications, Shared with Me, Changes, Help, Graph, Reviews and the dialogs the frame opens (mr/more). Read with pnpm styles:gen --app --only more --no-samples.",
  "screens": {
    "help": "folevi-dev://help",
    "graph": "folevi-dev://graph",
    "review": "folevi-dev://review",
    "palette": "folevi-dev://documents",
    "newfolder": "folevi-dev://documents",
    "toast": "folevi-dev://documents"
  },
  "styles": {
    "more.help.title": {
      "screen": "help",
      "selector": "section#support",
      "parent": 1,
      "nth": 0
    },
    "more.help.h2": {
      "screen": "help",
      "selector": "h2.text-large-title"
    },
    "more.help.intro": {
      "screen": "help",
      "selector": "h2.text-large-title + p"
    },
    "more.help.link": {
      "screen": "help",
      "selector": "h2.text-large-title + p a"
    },
    "more.help.support": {
      "screen": "help",
      "selector": "section#support"
    },
    "more.help.h3": {
      "screen": "help",
      "selector": "#h-support"
    },
    "more.help.support.text": {
      "screen": "help",
      "selector": "section#support > p"
    },
    "more.help.support.button": {
      "screen": "help",
      "selector": "section#support > a"
    },
    "more.help.shortcuts": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts']"
    },
    "more.help.shortcuts.h3": {
      "screen": "help",
      "selector": "#h-shortcuts"
    },
    "more.help.table": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] table"
    },
    "more.help.row": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] tr"
    },
    "more.help.row.last": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] tr:last-child"
    },
    "more.help.th": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] th"
    },
    "more.help.td": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] td"
    },
    "more.help.kbd": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] td kbd"
    },
    "more.help.footnote": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-shortcuts'] > p"
    },
    "more.help.sync": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync']"
    },
    "more.help.sync.h3": {
      "screen": "help",
      "selector": "#h-sync"
    },
    "more.help.grid": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dl"
    },
    "more.help.card": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dl > div"
    },
    "more.help.card2": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dl > div",
      "nth": 1
    },
    "more.help.card3": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dl > div",
      "nth": 2
    },
    "more.help.dt": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dt"
    },
    "more.help.dd": {
      "screen": "help",
      "selector": "section[aria-labelledby='h-sync'] dd"
    },
    "more.help.main": {
      "screen": "help",
      "selector": "section#support",
      "parent": 2
    },
    "more.empty": {
      "screen": "graph",
      "selector": "[data-empty-state]"
    },
    "more.empty.tile": {
      "screen": "graph",
      "selector": "[data-empty-state] > span"
    },
    "more.empty.title": {
      "screen": "graph",
      "selector": "[data-empty-state] > h2"
    },
    "more.empty.body": {
      "screen": "graph",
      "selector": "[data-empty-state] > p"
    },
    "more.review.header": {
      "screen": "review",
      "selector": "header:has(button[aria-label='New cards a day'])"
    },
    "more.review.subtitle": {
      "screen": "review",
      "selector": "header:has(button[aria-label='New cards a day']) [role='status']"
    },
    "more.review.select": {
      "screen": "review",
      "selector": "button[aria-label='New cards a day']"
    },
    "more.review.region": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards']"
    },
    "more.review.empty": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards'] [data-empty-state]"
    },
    "more.review.empty.title": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards'] [data-empty-state] > h2"
    },
    "more.review.empty.body": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards'] [data-empty-state] > p"
    },
    "more.review.empty.hint": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards'] [data-empty-state] > p:nth-of-type(2)"
    },
    "more.review.empty.tile": {
      "screen": "review",
      "selector": "[role='region'][aria-label='Review cards'] [data-empty-state] > span"
    },
    "more.review.select.label": {
      "screen": "review",
      "selector": "button[aria-label='New cards a day'] > span"
    },
    "more.review.select.chevron": {
      "screen": "review",
      "selector": "button[aria-label='New cards a day'] > svg"
    },
    "more.palette": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands']"
    },
    "more.palette.bar": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] > div > div:first-child"
    },
    "more.palette.icon": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] > div > div:first-child svg"
    },
    "more.palette.input": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] input[role='combobox']"
    },
    "more.palette.esc": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] > div > div:first-child kbd"
    },
    "more.palette.filters": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] [role='group'][aria-label='Search filters']"
    },
    "more.palette.filter": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] [aria-label='Search filters'] > button"
    },
    "more.palette.filter.label": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] [aria-label='Search filters'] > button > span"
    },
    "more.palette.filter.chevron": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] [aria-label='Search filters'] > button > svg"
    },
    "more.palette.place": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] [aria-label='Search filters'] > span"
    },
    "more.palette.list": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] div.overflow-y-auto"
    },
    "more.palette.caps": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] div.overflow-y-auto > p.ui-caps"
    },
    "more.palette.heading": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='presentation']"
    },
    "more.palette.option.on": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='true']"
    },
    "more.palette.option.on.label": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='true'] > span.flex-1"
    },
    "more.palette.option": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='false']"
    },
    "more.palette.option.icon": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='false'] > span:first-child"
    },
    "more.palette.option.label": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='false'] > span.flex-1"
    },
    "more.palette.option.hint": {
      "screen": "palette",
      "selector": "dialog[open][aria-label='Search and commands'] li[role='option'][aria-selected='false'] > span.text-footnote"
    },
    "more.dialog.sm": {
      "screen": "newfolder",
      "selector": "dialog[open]"
    },
    "more.dialog.header": {
      "screen": "newfolder",
      "selector": "dialog[open] header"
    },
    "more.dialog.title": {
      "screen": "newfolder",
      "selector": "dialog[open] header h2"
    },
    "more.dialog.close": {
      "screen": "newfolder",
      "selector": "dialog[open] header button"
    },
    "more.dialog.body": {
      "screen": "newfolder",
      "selector": "dialog[open] header + div"
    },
    "more.prompt.label": {
      "screen": "newfolder",
      "selector": "dialog[open] form label"
    },
    "more.prompt.input": {
      "screen": "newfolder",
      "selector": "dialog[open] form input"
    },
    "more.prompt.actions": {
      "screen": "newfolder",
      "selector": "dialog[open] form > div"
    },
    "more.prompt.cancel": {
      "screen": "newfolder",
      "selector": "dialog[open] form button[type='button']"
    },
    "more.prompt.submit": {
      "screen": "newfolder",
      "selector": "dialog[open] form button[type='submit']"
    },
    "more.toast": {
      "screen": "toast",
      "selector": ".ui-toasts [role='alert']"
    },
    "more.toast.text": {
      "screen": "toast",
      "selector": ".ui-toasts [role='alert'] > span"
    },
    "more.toast.close": {
      "screen": "toast",
      "selector": ".ui-toasts [role='alert'] > button"
    },
    "more.toast.region": {
      "screen": "toast",
      "selector": ".ui-toasts"
    }
  },
  "vars": [
    "color-accent",
    "color-surface",
    "color-surface-sunken",
    "color-line",
    "color-ink-faint",
    "color-accent-soft",
    "color-coral",
    "color-moss",
    "color-marigold",
    "color-plum",
    "color-focus",
    "color-ink-muted",
    "color-line-strong",
    "color-canvas",
    "color-heading",
    "color-ink",
    "glass-hover",
    "glass-active",
    "color-danger",
    "mac-sheet-shadow",
    "mac-pop-edge",
    "color-accent-strong",
    "color-accent-ink",
    "color-success-soft",
    "color-danger-soft",
    "shadow-pop"
  ],
  "prepare": {
    "palette": "document.querySelectorAll('dialog[open]').forEach(d => d.close()); await new Promise(r => setTimeout(r, 300)); document.querySelector(\"nav[aria-label='Folio'] button.ui-well\").click(); return true",
    "newfolder": "document.querySelectorAll('dialog[open]').forEach(d => d.close()); await new Promise(r => setTimeout(r, 300)); document.querySelector(\"nav[aria-label='Folio'] section > div:first-child > button\").click(); return true",
    "toast": "document.querySelectorAll('dialog[open]').forEach(d => d.close()); window.dispatchEvent(new CustomEvent('folevi:error', { detail: 'Something went wrong. Please try again.' })); await new Promise(r => setTimeout(r, 400)); return true"
  }
}
