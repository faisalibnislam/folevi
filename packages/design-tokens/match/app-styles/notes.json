{
  "$description": "Home and every note list (HomeDashboard, NoteCardFace, FolderCard, DocumentBrowser, OrganizeIndex): the screens' links, the elements the native screens are drawn from, and the colour variables. Read by scripts/web-styles.mjs --app into ../app-styles-cache/notes.json. 'noteslist' and 'notescompact' switch All notes to the List and Compact layouts first; 'notesgrid' switches it back (the web keeps the layout in local storage).",
  "screens": {
    "home": "folevi-dev://documents",
    "notes": "folevi-dev://notes",
    "noteslist": "folevi-dev://notes",
    "notescompact": "folevi-dev://notes",
    "notesgrid": "folevi-dev://notes",
    "archive": "folevi-dev://archive",
    "folder": "folevi-dev://documents",
    "folders": "folevi-dev://folders",
    "tags": "folevi-dev://tags",
    "notesmenu": "folevi-dev://notes"
  },
  "prepare": {
    "noteslist": "document.querySelector(\"main#main .ui-seg button[aria-label='List']\").click(); return 1",
    "notescompact": "document.querySelector(\"main#main .ui-seg button[aria-label='Compact cards']\").click(); return 1",
    "notesgrid": "document.querySelector(\"main#main .ui-seg button[aria-label='Grid']\").click(); return 1",
    "folder": "[...document.querySelectorAll(\"nav a[href^='/folders/']\")].find((a) => a.textContent.trim() === 'Travel').click(); return 1",
    "notesmenu": "const b = document.querySelector(\"main#main ul.grid > li [data-card-menu] button\"); b.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true })); b.click(); return 1"
  },
  "styles": {
    "notes.home.content": {
      "screen": "home",
      "selector": "main#main > div:nth-child(2)"
    },
    "notes.catchup.button": {
