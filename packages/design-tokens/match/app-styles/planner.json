    "today": "folevi-dev://tasks/today",
    "upcoming": "folevi-dev://tasks/upcoming",
    "completed": "folevi-dev://tasks/completed",
    "edit": "folevi-dev://tasks/today",
    "date": "folevi-dev://tasks/today",
