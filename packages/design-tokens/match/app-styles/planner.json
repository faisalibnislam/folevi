  },
  "prepare": {
    "edit": "const i=document.querySelector('main#main label input'); if (i && i.value) { Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,''); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(r=>setTimeout(r,600)); } document.querySelector(\"button[title='Edit task']\").click();",
    "date": "const i=document.querySelector('main#main label input'); if (i && i.value) { Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,''); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(r=>setTimeout(r,600)); } document.querySelector(\"button[title='Edit task']\").click(); await new Promise(r=>setTimeout(r,500)); document.querySelector(\"button[aria-label^='Due date']\").click();",
    "quick": "const i=document.querySelector('main#main label input'); if (i && i.value) { Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,''); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(r=>setTimeout(r,600)); } [...document.querySelectorAll('main button')].find(b=>b.textContent.trim()==='Add task').click();",
    "week": "[...document.querySelectorAll('[role=radio]')].find(b=>b.textContent.trim()==='week').click(); await new Promise(r=>setTimeout(r,800));",
    "agenda": "[...document.querySelectorAll('[role=radio]')].find(b=>b.textContent.trim()==='agenda').click(); await new Promise(r=>setTimeout(r,800));",
    "cals": "[...document.querySelectorAll('[role=radio]')].find(b=>b.textContent.trim()==='month').click(); await new Promise(r=>setTimeout(r,800)); [...document.querySelectorAll('main button')].find(b=>b.textContent.trim()==='Calendars').click();",
    "month": "[...document.querySelectorAll('[role=radio]')].find(b=>b.textContent.trim()==='month').click(); await new Promise(r=>setTimeout(r,800));",
    "empty": "const i=document.querySelector('main#main label input'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,'zzzz'); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(r=>setTimeout(r,600));",
    "today": "const i=document.querySelector('main#main label input'); if (i && i.value) { Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set.call(i,''); i.dispatchEvent(new Event('input',{bubbles:true})); await new Promise(r=>setTimeout(r,600)); } "
  },
