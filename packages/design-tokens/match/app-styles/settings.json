  "vars": [
    "color-surface",
    "color-accent",
    "color-accent-soft",
    "color-accent-soft-ink",
    "color-danger",
    "color-line",
    "color-heading",
    "color-ink",
    "color-ink-muted",
    "color-ink-faint",
    "color-canvas",
    "glass-hover",
    "glass-active",
    "glass-border",
    "glass-edge",
    "color-focus"
  ]
}