{
  "$description": "Canonical Folevi block schema. Source of truth for generated TypeScript (src/generated/schema.ts), Swift (apps/macos/Folevi/Domain/Generated/BlockSchema.swift) and JSON Schema (generated/folevi-blocks.schema.json). Bump schemaVersion and add a migration in src/migrations.ts for any breaking change. Blocks marked \"webOnly\" are left out of the Swift types until the native apps draw them; native clients keep them verbatim as unknown blocks.",
  "schemaVersion": 1,
  "enums": {
    "HeadingLevel": { "type": "int", "values": [1, 2, 3] },
    "CalloutTone": { "type": "string", "values": ["note", "info", "success", "warning", "danger"] },
    "TextColor": {
      "type": "string",
      "values": ["muted", "accent", "moss", "marigold", "plum", "coral"]
    },
    "HighlightColor": { "type": "string", "values": ["yellow", "green", "blue", "pink"] },
    "TaskPriority": { "type": "string", "values": ["none", "low", "medium", "high"] },
    "PageDisplay": { "type": "string", "values": ["link", "card"] },
    "DocumentFont": { "type": "string", "values": ["sans", "serif", "mono", "rounded"] },
    "DocumentWidth": { "type": "string", "values": ["narrow", "default", "wide"] },
    "DocumentBackground": { "type": "string", "values": ["paper", "plain", "tinted", "grid"] },
    "DocumentAccent": {
      "type": "string",
      "values": ["accent", "moss", "marigold", "plum", "coral"]
    },
    "CardStyle": { "type": "string", "values": ["folio", "plain", "tinted", "outline"] },
    "CoverKind": { "type": "string", "values": ["none", "color", "gradient", "image", "art"] },
    "DocumentKind": {
      "type": "string",
      "values": ["document", "daily", "template", "collectionRow"]
    },
    "DocumentSheet": {
      "type": "string",
      "values": ["white", "paper", "ivory", "mist", "sage", "blush", "night"]
    },
    "DocumentText": {
      "type": "string",
      "values": ["ink", "slate", "navy", "forest", "plum", "brown", "white"]
    },
    "SeparatorStyle": { "type": "string", "values": ["line", "dots", "doodle"] },
    "BlockTextStyle": { "type": "string", "values": ["strong", "caption"] },
    "BlockDecoration": { "type": "string", "values": ["focus", "block"] },
    "BlockColor": {
      "type": "string",
      "values": [
        "black",
        "slate",
        "gray",
        "navy",
        "blue",
        "sky",
        "green",
        "purple",
        "red",
        "orange",
        "brown"
      ]
    },
    "BlockAlign": { "type": "string", "values": ["left", "center", "right", "justify"] },
    "BlockFont": { "type": "string", "values": ["system", "serif", "mono", "rounded"] },
    "BlockGroup": { "type": "string", "values": ["page", "card"] },
    "DividerStyle": { "type": "string", "values": ["extralight", "light", "regular", "strong"] }
  },
  "unions": {
    "Mark": {
      "discriminator": "type",
      "variants": {
        "bold": {},
        "italic": {},
        "underline": {},
        "strike": {},
        "code": {},
        "link": { "href": "string" },
        "color": { "value": "TextColor" },
        "highlight": { "value": "HighlightColor" }
      }
    },
    "InlineNode": {
      "discriminator": "type",
      "variants": {
        "text": { "text": "string", "marks": "Mark[]?" },
        "mention": { "userId": "string", "label": "string" },
        "date": { "date": "string" },
        "pageLink": { "documentId": "string", "label": "string" }
      }
    }
  },
  "structs": {
    "DocumentStyle": {
      "font": "DocumentFont",
      "width": "DocumentWidth",
      "background": "DocumentBackground",
      "accent": "DocumentAccent",
      "card": "CardStyle",
      "backdrop": "string?",
      "sheet": "DocumentSheet?",
      "text": "DocumentText?",
      "separator": "SeparatorStyle?",
      "blur": "bool?"
    },
    "DocumentCover": {
      "kind": "CoverKind",
      "value": "string?"
    }
  },
  "blocks": {
    "paragraph": {
      "text": true,
      "props": {
        "textStyle": "BlockTextStyle?",
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "heading": {
      "text": true,
      "props": {
        "level": "HeadingLevel",
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "bulleted": {
      "text": true,
      "props": {
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "numbered": {
      "text": true,
      "props": {
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "todo": {
      "text": true,
      "props": {
        "checked": "bool",
        "canceled": "bool?",
        "dueDate": "string?",
        "dueTime": "string?",
        "priority": "TaskPriority?",
        "assigneeId": "string?",
        "reminderAt": "number?",
        "completedAt": "number?",
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "toggle": {
      "text": true,
      "props": {
        "collapsed": "bool",
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "quote": {
      "text": true,
      "props": {
        "decoration": "BlockDecoration?",
        "color": "BlockColor?",
        "align": "BlockAlign?",
        "font": "BlockFont?",
        "group": "BlockGroup?"
      }
    },
    "callout": { "text": true, "props": { "tone": "CalloutTone", "icon": "string?" } },
    "divider": { "text": false, "props": { "style": "DividerStyle?" } },
    "pageBreak": { "text": false, "props": {} },
    "code": { "text": false, "props": { "language": "string", "code": "string" } },
    "image": {
      "text": false,
      "props": {
        "fileId": "string?",
        "url": "string?",
        "alt": "string",
        "caption": "string",
        "width": "number?",
        "naturalWidth": "number?",
        "naturalHeight": "number?"
      }
    },
    "file": {
      "text": false,
      "props": { "fileId": "string", "name": "string", "size": "number", "mimeType": "string" }
    },
    "table": {
      "text": false,
      "props": { "rows": "InlineNode[][][]", "headerRow": "bool" }
    },
    "page": {
      "text": false,
      "props": {
        "documentId": "string",
        "display": "PageDisplay",
        "titleCache": "string?",
        "iconCache": "string?"
      }
    },
    "bookmark": {
      "text": false,
      "props": {
        "url": "string",
        "title": "string?",
        "description": "string?",
        "siteName": "string?"
      }
    },
    "collection": {
      "text": false,
      "props": { "collectionId": "string", "viewId": "string?" }
    },
    "formula": { "text": false, "props": { "latex": "string" } },
    "whiteboard": { "text": false, "props": { "data": "string", "height": "number" } },
    "flowchart": {
      "text": false,
      "webOnly": true,
      "props": { "data": "string", "height": "number" }
    },
    "audio": {
      "text": false,
      "webOnly": true,
      "props": {
        "fileId": "string",
        "name": "string",
        "size": "number",
        "mimeType": "string",
        "duration": "number"
      }
    }
  },
  "limits": {
    "maxTextLength": 20000,
    "maxCodeLength": 100000,
    "maxDepth": 8,
    "maxTableRows": 200,
    "maxTableColumns": 20,
    "maxBlocksPerDocument": 5000,
    "maxRankLength": 128,
    "maxFormulaLength": 10000,
    "maxWhiteboardDataLength": 200000,
    "minWhiteboardHeight": 120,
    "maxWhiteboardHeight": 2400,
    "maxFlowchartDataLength": 200000,
    "minFlowchartHeight": 200,
    "maxFlowchartHeight": 1600
  },
  "codeLanguages": [
    "plaintext",
    "bash",
    "c",
    "cpp",
    "csharp",
    "css",
    "diff",
    "go",
    "graphql",
    "html",
    "java",
    "javascript",
    "json",
    "kotlin",
    "latex",
    "markdown",
    "mermaid",
    "php",
    "python",
    "ruby",
    "rust",
    "sql",
    "swift",
    "toml",
    "typescript",
    "xml",
    "yaml"
  ]
}
