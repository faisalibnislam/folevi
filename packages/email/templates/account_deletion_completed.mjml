<mjml lang="en" dir="ltr">
  <mj-head>
    <!--
      GENERATED by packages/email/scripts/build-templates.ts; edit the script, not this file.
      Template: account_deletion_completed (security). Loops env var: LOOPS_TRANSACTIONAL_ACCOUNT_DELETION_COMPLETED_ID.
      Sender: Folevi <security@LOOPS_SENDING_DOMAIN>.
      Import: copy to index.mjml, zip, upload via Loops editor > Code (docs/EMAIL_OPERATIONS.md).
    -->
    <mj-title>Your Folevi account has been deleted</mj-title>
    <mj-preview>Your account and its data have been deleted.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text color="#0B0B0C" font-size="16px" line-height="26px" padding="0 32px 16px 32px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .fv-link { color: #111114; text-decoration: underline; }
      @media (prefers-color-scheme: dark) {
        body, .fv-body, .fv-canvas, .fv-canvas table, .fv-canvas td { background-color: #0B0B0C !important; }
        /* The logo tile keeps its brand colours: white tile, black F. */
        .fv-canvas table.fv-mark, .fv-canvas table.fv-mark td { background-color: #FFFFFF !important; }
        .fv-canvas table.fv-mark td.fv-mark-on { background-color: #000000 !important; }
        .fv-card, .fv-card table, .fv-card td { background-color: #18181B !important; border-color: #2A2A2D !important; }
        .fv-card div, .fv-card td, .fv-card strong, .fv-wordmark div { color: #F2F2F3 !important; }
        .fv-muted div, .fv-muted-cell, .fv-canvas .fv-muted div { color: #A1A1AA !important; }
        .fv-link, .fv-card a.fv-link { color: #F2F2F3 !important; }
        .fv-button td, .fv-button a, .fv-button p { background-color: #F2F2F3 !important; color: #0B0B0C !important; }
        .fv-code-box { background-color: #0B0B0C !important; border-color: #2A2A2D !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F5" width="600px" css-class="fv-body">
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="32px 12px 8px 12px">
      <mj-section>
        <mj-column>
          <mj-raw>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 20px;">
              <tr>
                <td style="vertical-align:middle;padding-right:10px;"><table role="presentation" aria-hidden="true" cellpadding="0" cellspacing="0" border="0" class="fv-mark" style="border-collapse:separate;border:1px solid #DFDFE2;border-radius:7px;background-color:#FFFFFF;overflow:hidden;width:28px;height:28px;"><tr><td style="width:5px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:6px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:10px;height:5px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:5px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:4px;height:4px;background-color:#000000;border-radius:2px 0 0 0;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:3px;height:4px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:6px;height:4px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:10px;height:4px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:5px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:4px;height:5px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:6px;height:5px;font-size:0;line-height:0;">&nbsp;</td><td style="width:10px;height:5px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:5px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:4px;height:4px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:6px;height:4px;background-color:#000000;border-radius:1px;font-size:0;line-height:0;">&nbsp;</td><td style="width:10px;height:4px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:5px;height:10px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:4px;height:10px;background-color:#000000;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;height:10px;font-size:0;line-height:0;">&nbsp;</td><td style="width:6px;height:10px;font-size:0;line-height:0;">&nbsp;</td><td style="width:10px;height:10px;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>
                <td class="fv-wordmark" style="vertical-align:middle;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;line-height:24px;color:#0B0B0C;letter-spacing:-0.6px;"><div style="color:#0B0B0C;">Folevi</div></td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="0 12px">
      <mj-section css-class="fv-card" background-color="#FFFFFF" border="1px solid #E4E4E7" border-radius="12px" padding="28px 0 16px 0">
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="20px" letter-spacing="1px" text-transform="uppercase" padding="0 32px 8px 32px">Your account</mj-text>
        <mj-text font-family="'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif" font-size="28px" line-height="36px" padding="0 32px 16px 32px"><h1 style="margin:0;font-size:28px;line-height:36px;font-weight:normal;font-family:'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif;">Your account has been deleted</h1></mj-text>
        <mj-text>Your Folevi account and its data were permanently deleted on <strong>{DATA_VARIABLE:completedOn}</strong>. This is the last email you will receive about this account.</mj-text>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">Limited records may be retained where the law requires it, as described in the Folevi privacy policy. Thank you for writing with Folevi.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="16px 12px 32px 12px">
      <mj-section>
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">This is a required email about the security of your Folevi account, so it is sent even if you have turned off notifications.</mj-text>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">Folevi · A quieter place for ideas that keep growing.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
