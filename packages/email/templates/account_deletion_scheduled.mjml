<mjml lang="en" dir="ltr">
  <mj-head>
    <!--
      GENERATED by packages/email/scripts/build-templates.ts; edit the script, not this file.
      Template: account_deletion_scheduled (security). Loops env var: LOOPS_TRANSACTIONAL_ACCOUNT_DELETION_SCHEDULED_ID.
      Sender: Folevi <security@LOOPS_SENDING_DOMAIN>.
      Import: copy to index.mjml, zip, upload via Loops editor > Code (docs/EMAIL_OPERATIONS.md).
    -->
    <mj-title>Your Folevi account is scheduled for deletion</mj-title>
    <mj-preview>Your account and notes will be deleted. You can still cancel.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text color="#0B0B0C" font-size="16px" line-height="26px" padding="0 32px 16px 32px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .fv-link { color: #111114; text-decoration: underline; }
      @media (prefers-color-scheme: dark) {
        body, .fv-body, .fv-canvas, .fv-canvas table, .fv-canvas td { background-color: #0B0B0C !important; }
        /* The logo tile keeps its brand colours: black folio, white clasp. */
        .fv-canvas table.fv-mark, .fv-canvas table.fv-mark td { background-color: #0B0B0C !important; }
        .fv-canvas table.fv-mark td.fv-mark-on { background-color: #FFFFFF !important; }
        .fv-canvas table.fv-mark td.fv-mark-band { background-color: #BDBDC2 !important; }
        .fv-card, .fv-card table, .fv-card td { background-color: #18181B !important; border-color: #2A2A2D !important; }
        .fv-card div, .fv-card td, .fv-card strong, .fv-wordmark div { color: #F2F2F3 !important; }
        .fv-muted div, .fv-muted-cell, .fv-canvas .fv-muted div { color: #A1A1AA !important; }
        .fv-link, .fv-card a.fv-link { color: #F2F2F3 !important; }
        .fv-button td, .fv-button a, .fv-button p { background-color: #F2F2F3 !important; color: #0B0B0C !important; }
        .fv-code-box { background-color: #0B0B0C !important; border-color: #2A2A2D !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F5" width="600px" css-class="fv-body">
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="32px 12px 8px 12px">
      <mj-section>
        <mj-column>
          <mj-raw>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 20px;">
              <tr>
                <td style="vertical-align:middle;padding-right:10px;"><table role="presentation" aria-hidden="true" cellpadding="0" cellspacing="0" border="0" class="fv-mark" style="border-collapse:separate;border:1px solid #2A2A2E;border-radius:7px;background-color:#0B0B0C;overflow:hidden;width:28px;height:28px;"><tr><td style="width:15px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;height:4px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:4px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:4px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:3px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:3px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:3px;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:3px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:3px;height:3px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:3px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:3px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:6px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:6px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:6px;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:6px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-band" style="width:3px;height:6px;background-color:#BDBDC2;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:6px;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:6px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:2px;height:1px;background-color:#FFFFFF;border-radius:2px 0 0 2px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:2px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:3px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:1px;background-color:#FFFFFF;border-radius:0 2px 2px 0;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:2px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:2px;height:2px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:2px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:2px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:3px;height:2px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:2px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:2px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:2px;height:1px;background-color:#FFFFFF;border-radius:2px 0 0 2px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:2px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:3px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-on" style="width:1px;height:1px;background-color:#FFFFFF;border-radius:0 2px 2px 0;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="width:15px;height:11px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:11px;font-size:0;line-height:0;">&nbsp;</td><td style="width:2px;height:11px;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:11px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-band" style="width:3px;height:11px;background-color:#BDBDC2;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:11px;font-size:0;line-height:0;">&nbsp;</td><td style="width:4px;height:11px;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>
                <td class="fv-wordmark" style="vertical-align:middle;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;line-height:24px;color:#0B0B0C;letter-spacing:-0.6px;"><div style="color:#0B0B0C;">Folevi</div></td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="0 12px">
      <mj-section css-class="fv-card" background-color="#FFFFFF" border="1px solid #E4E4E7" border-radius="12px" padding="28px 0 16px 0">
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="20px" letter-spacing="1px" text-transform="uppercase" padding="0 32px 8px 32px">Your account</mj-text>
        <mj-text font-family="'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif" font-size="28px" line-height="36px" padding="0 32px 16px 32px"><h1 style="margin:0;font-size:28px;line-height:36px;font-weight:normal;font-family:'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif;">Your account is scheduled for deletion</h1></mj-text>
        <mj-text>As requested, your Folevi account and everything in it, including notes, documents and the workspaces you own, will be permanently deleted on <strong>{DATA_VARIABLE:scheduledFor}</strong>.</mj-text>
        <mj-text>Until then, you can change your mind.</mj-text>
        <mj-button href="{DATA_VARIABLE:cancelUrl}" css-class="fv-button" background-color="#111114" color="#FFFFFF" font-size="16px" font-weight="600" border-radius="8px" inner-padding="13px 24px" align="left" padding="12px 32px 8px 32px">Cancel account deletion</mj-button>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px" padding="4px 32px 16px 32px">Button not working? Paste this link into your browser:<br /><a href="{DATA_VARIABLE:cancelUrl}" class="fv-link" style="color:#111114;word-break:break-all;">{DATA_VARIABLE:cancelUrl}</a></mj-text>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">If you did not request this, cancel the deletion and change your password right away.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="16px 12px 32px 12px">
      <mj-section>
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">This is a required email about the security of your Folevi account, so it is sent even if you have turned off notifications.</mj-text>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">Folevi · A quieter place for ideas that keep growing.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
