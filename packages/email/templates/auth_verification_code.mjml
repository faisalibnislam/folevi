<mjml lang="en" dir="ltr">
  <mj-head>
    <!--
      GENERATED by packages/email/scripts/build-templates.ts; edit the script, not this file.
      Template: auth_verification_code (identity). Loops env var: LOOPS_TRANSACTIONAL_AUTH_VERIFICATION_CODE_ID.
      Sender: Folevi <security@LOOPS_SENDING_DOMAIN>.
      Import: copy to index.mjml, zip, upload via Loops editor > Code (docs/EMAIL_OPERATIONS.md).
    -->
    <mj-title>Your Folevi verification code</mj-title>
    <mj-preview>Enter this one-time code to continue. It expires shortly.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text color="#18201C" font-size="16px" line-height="26px" padding="0 32px 16px 32px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .fv-link { color: #3159D8; }
      @media (prefers-color-scheme: dark) {
        .fv-body, .fv-canvas, .fv-canvas table, .fv-canvas td { background-color: #121714 !important; }
        .fv-card, .fv-card table, .fv-card td { background-color: #1B221E !important; border-color: #343C37 !important; }
        .fv-card div, .fv-card td, .fv-card strong, .fv-wordmark div { color: #ECE9E0 !important; }
        .fv-muted div, .fv-muted-cell, .fv-canvas .fv-muted div { color: #AEB6AF !important; }
        .fv-link, .fv-card a.fv-link { color: #8FA8FF !important; }
        .fv-button table, .fv-button td, .fv-button a, .fv-button p { background-color: #8FA8FF !important; color: #121714 !important; }
        .fv-code-box { background-color: #121714 !important; border-color: #343C37 !important; }
        .fv-mark-stem { background-color: #ECE9E0 !important; }
        .fv-mark-leaf { background-color: #8FA8FF !important; }
        .fv-mark-leaf2 { background-color: #AEB6AF !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F1E9" width="600px" css-class="fv-body">
    <mj-wrapper css-class="fv-canvas" background-color="#F4F1E9" padding="32px 12px 8px 12px">
      <mj-section>
        <mj-column>
          <mj-raw>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 20px;">
              <tr>
                <td style="vertical-align:middle;padding-right:10px;"><table role="presentation" aria-hidden="true" cellpadding="0" cellspacing="0" border="0" style="border-collapse:separate;"><tr><td rowspan="3" class="fv-mark-stem" style="width:4px;height:20px;background-color:#18201C;border-radius:2px;font-size:0;line-height:0;">&nbsp;</td><td style="width:3px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-leaf" style="width:13px;height:7px;background-color:#3159D8;border-radius:0 8px 0 8px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td style="height:3px;font-size:0;line-height:0;" colspan="2">&nbsp;</td></tr><tr><td style="width:3px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-mark-leaf2" style="width:9px;height:7px;background-color:#5F6962;border-radius:0 7px 0 7px;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>
                <td class="fv-wordmark" style="vertical-align:middle;font-family:'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif;font-size:22px;line-height:24px;color:#18201C;letter-spacing:0.2px;"><div style="color:#18201C;">Folevi</div></td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F1E9" padding="0 12px">
      <mj-section css-class="fv-card" background-color="#FBFAF6" border="1px solid #D8D7CF" border-radius="12px" padding="28px 0 16px 0">
        <mj-column>
        <mj-text css-class="fv-muted" color="#5F6962" font-size="14px" line-height="20px" letter-spacing="1px" text-transform="uppercase" padding="0 32px 8px 32px">Your account</mj-text>
        <mj-text font-family="'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif" font-size="28px" line-height="36px" padding="0 32px 16px 32px"><h1 style="margin:0;font-size:28px;line-height:36px;font-weight:normal;font-family:'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif;">Your verification code</h1></mj-text>
        <mj-text>Enter this code in Folevi to continue:</mj-text>
        <mj-text css-class="fv-code" align="left" font-family="ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace" font-size="30px" line-height="40px" letter-spacing="6px" padding="8px 32px 16px 32px"><span style="display:inline-block;padding:10px 18px;border:1px solid #D8D7CF;border-radius:8px;background-color:#F4F1E9;" class="fv-code-box">{DATA_VARIABLE:code}</span></mj-text>
        <mj-text css-class="fv-muted" color="#5F6962" font-size="14px" line-height="22px">The code expires in {DATA_VARIABLE:expiresInMinutes} minute(s) and works once. Folevi will never ask you to read this code out or send it to anyone. If you did not request it, you can ignore this email.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F1E9" padding="16px 12px 32px 12px">
      <mj-section>
        <mj-column>
        <mj-text css-class="fv-muted" color="#5F6962" font-size="14px" line-height="22px">This is a required email about the security of your Folevi account, so it is sent even if you have turned off notifications.</mj-text>
        <mj-text css-class="fv-muted" color="#5F6962" font-size="14px" line-height="22px">Folevi · The Living Folio</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
