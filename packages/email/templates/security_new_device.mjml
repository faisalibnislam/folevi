style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td style="width:1px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" colspan="2" style="width:2px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td colspan="13" style="width:13px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="3" style="width:3px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="12" style="width:12px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="5" style="width:5px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="12" style="width:12px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="5" style="width:5px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="12" style="width:12px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="5" style="width:5px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="12" style="width:12px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="4" style="width:4px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td colspan="13" style="width:13px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="3" style="width:3px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td colspan="14" style="width:14px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m3" style="width:1px;height:1px;background-color:#C2C2C2;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" style="width:1px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td colspan="16" style="width:16px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="9" style="width:9px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" colspan="2" style="width:2px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="17" style="width:17px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr></table></td>
                <td class="fv-wordmark" style="vertical-align:middle;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:22px;font-weight:700;line-height:24px;color:#0B0B0C;letter-spacing:-0.6px;"><div style="color:#0B0B0C;">Folevi</div></td>
              </tr>
            </table>
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="0 12px">
      <mj-section css-class="fv-card" background-color="#FFFFFF" border="1px solid #E4E4E7" border-radius="12px" padding="28px 0 16px 0">
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="20px" letter-spacing="1px" text-transform="uppercase" padding="0 32px 8px 32px">Account security</mj-text>
        <mj-text font-family="'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif" font-size="28px" line-height="36px" padding="0 32px 16px 32px"><h1 style="margin:0;font-size:28px;line-height:36px;font-weight:normal;font-family:'Iowan Old Style', 'Palatino Linotype', Georgia, ui-serif, 'Times New Roman', serif;">New sign-in to your account</h1></mj-text>
        <mj-text>Your Folevi account was just signed in to from a device we have not seen before.</mj-text>
        <mj-table css-class="fv-details" color="#0B0B0C" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" padding="4px 32px 12px 32px"><tr><td class="fv-muted-cell" style="padding:6px 16px 6px 0;color:#63636B;font-size:14px;white-space:nowrap;vertical-align:top;">Device</td><td style="padding:6px 0;font-size:15px;vertical-align:top;">{DATA_VARIABLE:deviceLabel}</td></tr><tr><td class="fv-muted-cell" style="padding:6px 16px 6px 0;color:#63636B;font-size:14px;white-space:nowrap;vertical-align:top;">Approximate location</td><td style="padding:6px 0;font-size:15px;vertical-align:top;">{DATA_VARIABLE:approximateLocation}</td></tr><tr><td class="fv-muted-cell" style="padding:6px 16px 6px 0;color:#63636B;font-size:14px;white-space:nowrap;vertical-align:top;">Time</td><td style="padding:6px 0;font-size:15px;vertical-align:top;">{DATA_VARIABLE:signedInAt}</td></tr></mj-table>
        <mj-text>If this was you, there is nothing else to do. If it was not, sign that device out and change your password.</mj-text>
        <mj-button href="{DATA_VARIABLE:securityUrl}" css-class="fv-button" background-color="#111114" color="#FFFFFF" font-size="16px" font-weight="600" border-radius="8px" inner-padding="13px 24px" align="left" padding="12px 32px 8px 32px">Review account security</mj-button>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px" padding="4px 32px 16px 32px">Button not working? Paste this link into your browser:<br /><a href="{DATA_VARIABLE:securityUrl}" class="fv-link" style="color:#111114;word-break:break-all;">{DATA_VARIABLE:securityUrl}</a></mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="16px 12px 32px 12px">
      <mj-section>
        <mj-column>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">This is a required email about the security of your Folevi account, so it is sent even if you have turned off notifications.</mj-text>
        <mj-text css-class="fv-muted" color="#63636B" font-size="14px" line-height="22px">Folevi · A quieter place for ideas that keep growing.</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
