<mjml lang="en" dir="ltr">
  <mj-head>
    <!--
      GENERATED by packages/email/scripts/build-templates.ts; edit the script, not this file.
      Template: security_new_device (security). Loops env var: LOOPS_TRANSACTIONAL_SECURITY_NEW_DEVICE_ID.
      Sender: Folevi <security@LOOPS_SENDING_DOMAIN>.
      Import: copy to index.mjml, zip, upload via Loops editor > Code (docs/EMAIL_OPERATIONS.md).
    -->
    <mj-title>New sign-in to your Folevi account</mj-title>
    <mj-preview>A new device signed in to your account. Review it if this was not you.</mj-preview>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-text color="#0B0B0C" font-size="16px" line-height="26px" padding="0 32px 16px 32px" />
      <mj-section padding="0" />
    </mj-attributes>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .fv-link { color: #111114; text-decoration: underline; }
      @media (prefers-color-scheme: dark) {
        body, .fv-body, .fv-canvas, .fv-canvas table, .fv-canvas td { background-color: #0B0B0C !important; }
        /* The mark keeps its brand colours: a white F on a black disc. */
        .fv-canvas table.fv-mark, .fv-canvas table.fv-mark td { background-color: #0B0B0C !important; }
        .fv-canvas table.fv-mark td.fv-m1 { background-color: #484849 !important; }
        .fv-canvas table.fv-mark td.fv-m2 { background-color: #858586 !important; }
        .fv-canvas table.fv-mark td.fv-m3 { background-color: #C2C2C2 !important; }
        .fv-canvas table.fv-mark td.fv-m4 { background-color: #FFFFFF !important; }
        .fv-card, .fv-card table, .fv-card td { background-color: #18181B !important; border-color: #2A2A2D !important; }
        .fv-card div, .fv-card td, .fv-card strong, .fv-wordmark div { color: #F2F2F3 !important; }
        .fv-muted div, .fv-muted-cell, .fv-canvas .fv-muted div { color: #A1A1AA !important; }
        .fv-link, .fv-card a.fv-link { color: #F2F2F3 !important; }
        .fv-button td, .fv-button a, .fv-button p { background-color: #F2F2F3 !important; color: #0B0B0C !important; }
        .fv-code-box { background-color: #0B0B0C !important; border-color: #2A2A2D !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F4F5" width="600px" css-class="fv-body">
    <mj-wrapper css-class="fv-canvas" background-color="#F4F4F5" padding="32px 12px 8px 12px">
      <mj-section>
        <mj-column>
          <mj-raw>
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 20px;">
              <tr>
                <td style="vertical-align:middle;padding-right:10px;"><table role="presentation" aria-hidden="true" cellpadding="0" cellspacing="0" border="0" class="fv-mark" style="border-collapse:separate;border:1px solid #1F2227;border-radius:50%;background-color:#0B0B0C;overflow:hidden;width:28px;height:28px;"><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="28" style="width:28px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="18" style="width:18px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" colspan="2" style="width:2px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td colspan="8" style="width:8px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="16" style="width:16px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="3" style="width:3px;height:1px;background-color:#FFFFFF;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td colspan="7" style="width:7px;height:1px;font-size:0;line-height:0;">&nbsp;</td></tr><tr><td colspan="13" style="width:13px;height:1px;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m1" style="width:1px;height:1px;background-color:#484849;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m2" style="width:1px;height:1px;background-color:#858586;font-size:0;line-height:0;">&nbsp;</td><td class="fv-m4" colspan="6" style="width:6px;height:1px;background-color:#FFFFFF;font