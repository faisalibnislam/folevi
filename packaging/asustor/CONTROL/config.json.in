{
  "general": {
    "package": "folevi",
    "name": "Folevi Server",
    "version": "@VERSION@",
    "depends": [],
    "conflicts": [],
    "developer": "Space Cherries LLC",
    "maintainer": "Space Cherries LLC",
    "email": "support@folevi.com",
    "website": "https://folevi.com/server",
    "architecture": "@APK_ARCH@",
    "firmware": "4.2.0"
  },
  "adm-desktop": {
    "app": {
      "type": "custom",
      "protocol": "http",
      "port": 8460,
      "url": "/"
    },
    "privilege": {
      "accessible": "administrators",
      "customizable": true
    }
  },
  "register": {
    "share-folder": [
      {
        "name": "Folevi",
        "description": "Folevi Server data: everyone's notes, files and backups"
      }
    ],
    "port": [8460, 8443],
    "boot-priority": {
      "start-order": 80,
      "stop-order": 20
    }
  }
}
