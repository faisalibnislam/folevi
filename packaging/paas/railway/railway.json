{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.railway"
  },
  "deploy": {
    "startCommand": "/usr/bin/tini -- /usr/local/bin/folevi-entrypoint run --data /data --bundle /opt/folevi",
    "healthcheckPath": "/.well-known/folevi.json",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
