######################################################################
# Folevi Server package routines (sourced by QDK's qinstall.sh during install and upgrade).
# Unverified on real QTS hardware: test before release.
######################################################################

# Removal hooks are strings that qinstall.sh writes into the uninstall script, hence the escaping.
# Never delete the owner's data on removal: only the program files and the runtime link go.
PKG_PRE_REMOVE="{
  [ -x \$SYS_QPKG_DIR/folevi.sh ] && \$SYS_QPKG_DIR/folevi.sh stop
}"

PKG_POST_REMOVE="{
  /bin/rm -rf /usr/local/lib/folevi-rt
}"

pkg_check_requirement(){
  case "$(/bin/uname -m)" in
    x86_64|aarch64) ;;
    *) err_log "Folevi Server needs a 64-bit NAS (x86-64 or ARM64)." ;;
  esac
  local mem_kb
  mem_kb=$(/bin/awk '/^MemTotal:/{print $2}' /proc/meminfo)
  [ "${mem_kb:-0}" -ge 1800000 ] || $CMD_ECHO "Warning: Folevi Server needs about 1 GB of free memory; this NAS has less than 2 GB."
}

# An upgrade: take a pre-update backup with the old version before its files are replaced.
pkg_pre_install(){
  if [ -x "$SYS_QPKG_DIR/bundle/bin/folevid" ] && [ -x "$SYS_QPKG_DIR/folevi.sh" ]; then
    "$SYS_QPKG_DIR/folevi.sh" stop
    "$SYS_QPKG_DIR/folevi.sh" backup || $CMD_ECHO "Pre-update backup did not finish; folevid backs up again before migrating."
  fi
}

pkg_post_install(){
  $CMD_CHMOD 755 "$SYS_QPKG_DIR/folevi.sh" "$SYS_QPKG_DIR/bundle/bin/folevid"
}
