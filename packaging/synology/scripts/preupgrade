#!/bin/sh
# Take a pre-update backup with the old program before it is replaced (it is started briefly if DSM has
# already stopped it). Runs as the package user.
. "$(dirname "$0")/common"
. "$(dirname "$0")/pre-update-backup"
DATA="$(data_dir)"
if [ -x "$FOLEVID" ] && [ -d "$DATA" ]; then
  plog "pre-update backup of $DATA"
  if folevi_pre_update_backup "$FOLEVID" "$DATA" "$BUNDLE" >> "$LOG_FILE" 2>&1; then
    plog "pre-update backup done"
  else
    # Not fatal: folevid also backs up before it migrates on first start of the new version.
    plog "pre-update backup failed; continuing (folevid backs up again before migrating)"
  fi
fi
exit 0
